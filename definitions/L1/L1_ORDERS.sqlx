config {
  type: "view",
  schema: "LAB_DataManagementAI",
  name: "L1_ORDERS_TEST",
  description: "注文親データのフラグ付与とNULL補完",
  tags: ["daily_table"]
}

SELECT
  order_id,
  customer_id,
  store_id,
  order_date,
  -- 未来日フラグ（JST考慮が必要な場合は適宜変更してください）
  (order_date > CURRENT_DATE('Etc/GMT-9')) AS is_future_date,
  -- ステータスのデフォルト埋め
  IF(status IS NULL OR TRIM(status) = '', 'pending', status) AS status,
  payment_method
FROM ${ref("ORDERS_TEST")}
